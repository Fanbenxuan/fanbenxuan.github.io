{
  "name": "benson-fan-hugoblox-homepage",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "Benson Fan — optics and computational imaging, based on the official Hugo Blox Academic CV template.",
  "scripts": {
    "prepare:css": "node scripts/prepare-tailwind.mjs",
    "dev": "node scripts/prepare-tailwind.mjs && hugo server --disableFastRender",
    "build": "node scripts/prepare-tailwind.mjs && hugo --gc --minify",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
